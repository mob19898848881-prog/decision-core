# 衡决·Decision Core — 语料蒸馏环境变量模板
#
# 用法（二选一）：
#   A. 交互式引导（推荐，密钥零落盘）：
#        powershell -ExecutionPolicy Bypass -File scripts\setup_gen_env.ps1
#   B. 手动设置（当前 PowerShell 会话有效，重启失效）：
#        $env:HENGJUE_GEN_BASE_URL="https://api.deepseek.com/v1"
#        $env:HENGJUE_GEN_API_KEY="sk-你的密钥"
#        $env:HENGJUE_GEN_MODEL="deepseek-v4-pro"
#
# 安全纪律（本项目铁律）：
#   - 密钥只从环境变量读取，不写入任何文件、不进 git、不打印回显；
#   - 不要把真实密钥复制进本文件——本文件是模板，只存放占位符。
#
# 变量说明：BASE_URL 填到 /v1 为止（脚本自动拼 /chat/completions），
# 任何 OpenAI 兼容端点均可（DeepSeek / Moonshot / 阿里百炼 / OneAPI 网关等）。

# ---- 出题+作答模型（必需）----
HENGJUE_GEN_BASE_URL=https://api.deepseek.com/v1
HENGJUE_GEN_API_KEY=sk-在这里填你的密钥
HENGJUE_GEN_MODEL=deepseek-chat

# ---- 证伪审查模型·极我角色（可选，缺省降级为 schema 单扫）----
# 建议用与出题模型不同的厂商/模型，互校才有效力
HENGJUE_CRITIC_BASE_URL=https://api.moonshot.cn/v1
HENGJUE_CRITIC_API_KEY=sk-在这里填你的密钥
HENGJUE_CRITIC_MODEL=kimi-k3
